# Copy this file to ".env" in the same folder and fill in what you use.
# ".env" is git-ignored: your real keys never leave your computer.

# ---- Option A: local models in LM Studio (free) --------------------------
# Start LM Studio's server (Developer tab -> Start Server), then use:
OPENAI_BASE_URL=http://127.0.0.1:1234/v1
OPENAI_API_BASE=http://127.0.0.1:1234/v1
OPENAI_API_KEY=lm-studio
# The model identifier exactly as LM Studio shows it:
LLM_MODEL=qwen/qwen3.6-35b-a3b
# Reasoning models (Qwen3.6, Gemma 4) think before answering; give them headroom:
LLM_REASONING_TOKENS=6000
# Optional: a different model for image input (project 27) and embeddings (project 15)
# LLM_VISION_MODEL=google/gemma-4-12b
# LLM_EMBED_MODEL=text-embedding-nomic-embed-text-v1.5

# ---- Option B: OpenAI (paid) -----------------------------------------------
# Comment out the four Option A lines above, then:
# OPENAI_API_KEY=sk-...
# LLM_MODEL=gpt-4o-mini
# LLM_REASONING_TOKENS=0

# ---- Other services ---------------------------------------------------------
# ANTHROPIC_API_KEY=sk-ant-...
# WATSONX_APIKEY=...
# WATSONX_PROJECT_ID=...
# WATSONX_URL=https://us-south.ml.cloud.ibm.com
# Optional: override project 17's watsonx models (IBM retires models; check your region's list)
# WATSONX_TEXT_MODEL=meta-llama/llama-3-3-70b-instruct
# WATSONX_VISION_MODEL=meta-llama/llama-4-maverick-17b-128e-instruct-fp8
# SERPAPI_KEY=...
# HF_TOKEN=hf_...
